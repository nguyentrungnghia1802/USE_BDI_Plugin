<?xml version="1.0" encoding="UTF-8"?>
<organisational-specification
    id="smart_home"
    os-version="0.7"
    xmlns="http://moise.sourceforge.net/os"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://moise.sourceforge.net/os http://moise.sourceforge.net/xml/os.xsd">
  <structural-specification>
    <role-definitions>
      <role id="resident"/>
    </role-definitions>
    <group-specification id="homeGroup">
      <roles>
        <role id="resident" min="1" max="4"/>
      </roles>
    </group-specification>
  </structural-specification>
  <functional-specification>
    <scheme id="prepareHome">
      <goal id="prepare_evening"/>
      <mission id="mPrepareHome" min="1" max="1">
        <goal id="prepare_evening"/>
      </mission>
    </scheme>
  </functional-specification>
  <normative-specification>
    <norm id="nPrepareHome" type="permission" role="resident" mission="mPrepareHome"/>
  </normative-specification>
</organisational-specification>
