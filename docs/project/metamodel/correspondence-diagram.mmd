classDiagram
    direction LR

    class DomainElement {
        <<JaCaMo analysis metaclass>>
    }
    class UseElement {
        <<read-only UML/OCL reference>>
    }
    class Correspondence {
        <<logical contract>>
        type
        sourceIdentity
        targetReference
        provenance
        evidence
    }
    class Candidate {
        <<review state>>
        heuristic only
    }
    class Confirmed {
        <<review state>>
        explicit decision
    }
    class Current {
        <<target validation>>
    }
    class Stale {
        <<target validation>>
    }
    class Unknown {
        <<target validation>>
    }

    DomainElement "1" --> "0..*" Correspondence : source
    Correspondence "0..*" --> "1" UseElement : target
    Correspondence <|-- Candidate
    Correspondence <|-- Confirmed
    Confirmed --> Current : revalidated
    Confirmed --> Stale : changed or missing
    Confirmed --> Unknown : insufficient evidence

